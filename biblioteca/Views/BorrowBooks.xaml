<Window x:Class="biblioteca.Views.BorrowBooks"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Borrow books" Height="420" Width="640">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Header}"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,16">

            <Grid>
                <Grid Width="360" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="InputBox"
                             Grid.Row="0"
                             Height="30"
                             VerticalContentAlignment="Center"
                             Text="{Binding InputValue, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="ISBN or signature"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="Gray"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Grid.Row="1"
                            Margin="0,2,0,0"
                            BorderThickness="1"
                            BorderBrush="#33000000"
                            Background="White"
                            Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVis}}">
                        <ListBox x:Name="SuggestionsList"
                                 ItemsSource="{Binding Suggestions}"
                                 DisplayMemberPath="Display"
                                 SelectionChanged="SuggestionsList_SelectionChanged"
                                 MaxHeight="140" />
                    </Border>
                </Grid>
            </Grid>

            <Button Content="Add"
                    Width="100"
                    Height="30"
                    Command="{Binding AddIsbnCommand}" />
        </StackPanel>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding BooksToBorrow}" />

        <Button Grid.Row="3"
                Content="Borrow"
                Width="120"
                Height="35"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Command="{Binding BorrowBooksCommand}" />
    </Grid>
</Window>
