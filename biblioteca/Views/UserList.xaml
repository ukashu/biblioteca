<UserControl x:Class="biblioteca.Views.UserList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:biblioteca.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ListView x:Name="usersListView" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <EventSetter Event="MouseDoubleClick" Handler="UserItem_MouseDoubleClick"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOverdueBooks}" Value="True">
                                <Setter Property="Background" Value="LightCoral"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding FirstName}" Width="140">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="FirstName" Click="usersListViewColumnHeader_Click">Imię</GridViewColumnHeader>
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <GridViewColumn DisplayMemberBinding="{Binding LastName}" Width="140">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="LastName" Click="usersListViewColumnHeader_Click">Nazwisko</GridViewColumnHeader>
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <GridViewColumn DisplayMemberBinding="{Binding Email}" Width="250">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Email" Click="usersListViewColumnHeader_Click">Email</GridViewColumnHeader>
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <GridViewColumn DisplayMemberBinding="{Binding IsActive}" Width="Auto">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="IsActive" Click="usersListViewColumnHeader_Click">Aktywny</GridViewColumnHeader>
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <GridViewColumn Header="" Width="Auto">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Wypożycz"
                                            Padding="8,2"
                                            Command="{Binding DataContext.BorrowBooksForUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </ScrollViewer>

        <Border Grid.Column="1" Margin="10,0,0,0" Padding="10" Background="#f9f9f9" BorderBrush="#ddd" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedUser}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel DataContext="{Binding SelectedUser}">
                <TextBlock Text="Szczegóły" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                <TextBlock Text="Numer telefonu: " FontWeight="Bold"/>
                <TextBlock Text="{Binding PhoneNumber}" Margin="0,0,0,10"/>
                <TextBlock Text="Numer karty czytelnika: " FontWeight="Bold"/>
                <TextBlock Text="{Binding CardNumber}" Margin="0,0,0,10"/>
                <TextBlock Text="Notatki: " FontWeight="Bold"/>
                <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="Wypożyczone książki: " FontWeight="Bold"/>
                <TextBlock Text="{Binding BorrowedBooksCount}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            </StackPanel>
        </Border>
        
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="2">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Imię" Margin="0,0,0,2"/>
                    <TextBox Width="100" Height="30" VerticalContentAlignment="Center" Name="FirstNameFilterTextBox" TextChanged="FirstNameFilterTextBox_TextChanged"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Nazwisko" Margin="0,0,0,2"/>
                    <TextBox Width="100" Height="30" VerticalContentAlignment="Center" Name="LastNameFilterTextBox" TextChanged="LastNameFilterTextBox_TextChanged"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Email" Margin="0,0,0,2"/>
                    <TextBox Width="100" Height="30" VerticalContentAlignment="Center" Name="EmailFilterTextBox" TextChanged="EmailFilterTextBox_TextChanged"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" Name="add_user_button" Content="Dodaj" Command="{Binding AddUserWithDialogCommand}" />
        </Grid>
    </Grid>
</UserControl>
