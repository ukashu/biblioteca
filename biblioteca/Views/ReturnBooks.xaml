<UserControl x:Class="biblioteca.Views.ReturnBooks"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">

        <!-- WSZYSTKO musi być w środku Grid -->
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Zwracanie książek"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Loans}"
                 SelectedItem="{Binding SelectedLoan}">
            
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding BookTitle}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding UserName}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <Button Grid.Row="2"
                Content="Zwróć książkę"
                Command="{Binding ReturnBookCommand}"
                Margin="0,20,0,0"
                Height="35"
                HorizontalAlignment="Right"/>

    </Grid>
</UserControl>