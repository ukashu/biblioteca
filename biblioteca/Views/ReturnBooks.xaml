<UserControl x:Class="biblioteca.Views.ReturnBooks"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Zwracanie książek"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- FILTRY -->
        <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            Margin="0,0,0,15">

            <!-- FILTR UŻYTKOWNIKA -->
            <StackPanel Margin="0,0,15,0">

                <TextBlock Text="Wypożyczający"
                   Margin="0,0,0,5"/>

                <TextBox Width="200"
                 Height="30"
                 VerticalContentAlignment="Center"
                 Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- FILTR ISBN -->
            <StackPanel>

                <TextBlock Text="ISBN"
                   Margin="0,0,0,5"/>

                <TextBox Width="200"
                 Height="30"
                 VerticalContentAlignment="Center"
                 Text="{Binding IsbnFilter, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

        </StackPanel>

        <ScrollViewer Grid.Row="2"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <!-- LISTA -->
            <ListBox ItemsSource="{Binding Loans}"
                 SelectedItem="{Binding SelectedLoan}">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">

                            <TextBlock Text="{Binding BookTitle}"
                                   FontWeight="Bold"/>

                            <TextBlock Text="{Binding UserName}"/>

                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </ScrollViewer>

        <!-- BUTTON -->
        <Button Grid.Row="3"
                Content="Zwróć książkę"
                Command="{Binding ReturnBookCommand}"
                Margin="0,20,0,0"
                Height="35"
                HorizontalAlignment="Right"/>

    </Grid>
</UserControl>