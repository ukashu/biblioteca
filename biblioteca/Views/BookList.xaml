<UserControl x:Class="biblioteca.Views.BookList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:biblioteca.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ListView x:Name="booksListView" ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook, Mode=TwoWay}" MouseDoubleClick="BooksList_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding Title}" Width="280">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Title" Click="booksListViewColumnHeader_Click">Title</GridViewColumnHeader>
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <GridViewColumn DisplayMemberBinding="{Binding Author}" Width="200">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Author" Click="booksListViewColumnHeader_Click">Author</GridViewColumnHeader>
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <GridViewColumn DisplayMemberBinding="{Binding PublicationYear}" Width="Auto">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="PublicationYear" Click="booksListViewColumnHeader_Click">Year</GridViewColumnHeader>
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <GridViewColumn Header="Available" DisplayMemberBinding="{Binding IsAvailable}" Width="Auto"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </ScrollViewer>

        <Border Grid.Column="1" Margin="10,0,0,0" Padding="10" Background="#f9f9f9" BorderBrush="#ddd" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem, ElementName=booksListView}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel DataContext="{Binding SelectedItem, ElementName=booksListView}">
                <TextBlock Text="Book Details" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                <TextBlock Text="Description: " FontWeight="Bold"/>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="Genre: " FontWeight="Bold"/>
                <TextBlock Text="{Binding Genre}" Margin="0,0,0,10"/>
                <TextBlock Text="ISBN: " FontWeight="Bold"/>
                <TextBlock Text="{Binding Signature}" Margin="0,0,0,10"/>
                <TextBlock Text="Year: " FontWeight="Bold"/>
                <TextBlock Text="{Binding PublicationYear}" Margin="0,0,0,10"/>
                <TextBlock Text="Borrowed by:" FontWeight="Bold"/>
                <TextBlock Text="{Binding DataContext.CurrentBorrower, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </StackPanel>
        </Border>
        
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="2">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Title" Margin="0,0,0,2"/>
                    <TextBox Width="100" Height="30" VerticalContentAlignment="Center" Name="TitleFilterTextBox" TextChanged="TitleFilterTextBox_TextChanged"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Author" Margin="0,0,0,2"/>
                    <TextBox Width="100" Height="30" VerticalContentAlignment="Center" Name="AuthorFilterTextBox" TextChanged="AuthorFilterTextBox_TextChanged"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Signature" Margin="0,0,0,2"/>
                    <TextBox Width="100" Height="30" VerticalContentAlignment="Center" Name="SignatureFilterTextBox" TextChanged="SignatureFilterTextBox_TextChanged"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" Name="add_book_button" Content="Add Book" HorizontalAlignment="Right" Command="{Binding AddBookWithDialogCommand}"/>
        </Grid>
    </Grid>
</UserControl>
